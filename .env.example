# Porta di ascolto del servizio (host, sia in locale che via Docker Compose).
# In Docker letta da docker-compose*.yml/Dockerfile CMD. In locale è il default
# per --port in app/main.py (python -m app.main), sovrascrivibile da CLI flag.
PORT=8088

# Configurazione LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60.0
# Caratteri massimi del markdown inviato all'LLM (default 8000 ~ 2700 token)
# Riduci se il server risponde 400 "exceeds context size"
LLM_MAX_PROMPT_CHARS=8000

# Autenticazione API REST dello Scraper (Bearer Token)
# Lascia vuoto per disabilitare l'autenticazione (SCONSIGLIATO se esposto su internet)
API_AUTH_TOKEN=your-super-secret-token-here

# Timeout globale per le operazioni di scraping (secondi)
SCRAPE_TIMEOUT=300

# Rate limiting per IP (formato: N/second|minute|hour|day)
RATE_LIMIT=20/minute

# Giorni di storico richieste mantenuti in data/metrics.db prima della pulizia
# automatica (job periodico ogni 6h). Non richiede restart.
METRICS_RETENTION_DAYS=30

# IP dei reverse proxy fidati (separati da virgola) da cui accettare gli header
# CF-Connecting-IP / X-Real-IP / X-Forwarded-For per risolvere il vero IP client.
# Default 127.0.0.1: corretto per Cloudflare Tunnel diretto su uvicorn o reverse
# proxy sullo stesso host. Lasciare vuoto solo se esposto direttamente su internet.
TRUSTED_PROXIES=127.0.0.1

# Forza il flag Secure sul cookie di sessione della dashboard (1 per abilitare).
# Non necessario dietro Cloudflare Tunnel: il flag viene impostato automaticamente
# quando arriva l'header X-Forwarded-Proto: https.
#AUTH_SECURE_COOKIE=1

# Debugging (true/false) - salva gli output in locale per analisi
DEBUG=false

# Auto-refresh dashboard (hot-reload)
REFRESH_ENABLED=true
REFRESH_INTERVAL=30
